PROJECT_NAME="KidsAI Studio Backend"
VERSION="2.0.0"
API_V1_STR=/api/v1
SECRET_KEY=your_secure_jwt_secret_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# LLM Provider Configuration
# Mode: auto | gemini | openai | kimi | local_mlx | mock
LLM_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
KIMI_API_KEY=your_kimi_api_key_here
LOCAL_MLX_MODEL_NAME=phi-3-mini  # Only used when LLM_PROVIDER=local_mlx

# Image Provider Configuration
# Mode: auto | flux | pollinations | mock
IMAGE_PROVIDER=auto
REPLICATE_API_KEY=r8_your_replicate_api_key_here
IMAGE_MODEL=black-forest-labs/flux-schnell
IMAGE_POLL_INTERVAL=1.0
IMAGE_TIMEOUT=60.0
# Note: Pollinations provider requires no API key (free unlimited)

# Animation Provider Configuration
# Mode: auto | wan | local_svd | mock
ANIMATION_PROVIDER=auto
ANIMATION_MODEL=wan-video/wan-2.1-1.3b
ANIMATION_POLL_INTERVAL=2.0
ANIMATION_TIMEOUT=120.0
# Note: Local SVD provider requires no API key (zero cost, runs locally on M4)

# Voice / TTS Provider Configuration
# Mode: auto | elevenlabs | kokoro | mock
VOICE_PROVIDER=auto
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
VOICE_TIMEOUT=35.0
# Note: Kokoro provider requires no API key (zero cost, runs locally on M4)

# Music / Audio Provider Configuration
# Mode: auto | stable_audio | huggingface_musicgen | mock
MUSIC_PROVIDER=auto
STABLE_AUDIO_API_KEY=sk-your_stability_api_key_here
MUSIC_MODEL=stable-audio
MUSIC_POLL_INTERVAL=2.0
MUSIC_TIMEOUT=60.0
HF_API_TOKEN=your_free_huggingface_token_here  # Get free token at https://huggingface.co/settings/tokens
# Note: Hugging Face MusicGen provider uses free inference API (rate limited but sufficient for 2 songs/day)
