# Development Dockerfile for Next.js Frontend
FROM node:20-alpine

WORKDIR /app

# Copy root package.json and workspace lockfiles
COPY apps/frontend/package*.json ./apps/frontend/

# Install dependencies
WORKDIR /app/apps/frontend
RUN npm install

# Copy source code
COPY apps/frontend ./

EXPOSE 3000

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

CMD ["npm", "run", "dev"]
