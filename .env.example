# KidsAI Studio Environment Variables Template (Production Ready)

# Application & Server Configuration
NODE_ENV=development
PORT=3000
PROJECT_NAME="KidsAI Studio"
API_V1_STR=/api/v1
SECRET_KEY=your_secure_jwt_secret_key_here

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase Authentication & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI Model Provider Credentials
FLUX_API_KEY=your_flux_api_key_here
WAN_API_KEY=your_wan_22_api_key_here
KOKORO_API_KEY=your_kokoro_tts_api_key_here
STABLE_AUDIO_API_KEY=your_stable_audio_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Storage & Cloudflare R2 / AWS S3
R2_BUCKET=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# Stripe Subscription & Billing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0
